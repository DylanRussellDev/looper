# Build output
/dist/
/out-tsc/
/tmp/
*.tsbuildinfo

# Angular cache
/.angular/
/.ng/

# Dependencies
# package-lock.json stays tracked: it pins the exact versions `npm ci` installs.
/node_modules/
/yarn.lock
/pnpm-lock.yaml

# Tests
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/test-output/

# Environment files
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors: keep the shared VS Code setup, ignore personal settings
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Claude
/memory.md
/.claude/
